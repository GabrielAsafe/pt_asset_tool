        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Guarda da Prisão"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Alguns guerreiros tentam pular, aí dentro, para chamar a atenção... mas, que vergonha!"
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Ouvi dizer que os Tempskrons guardam Wolverines em suas celas... mas, que desperdício!"
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Esta é a cela para os criminosos da cidade. Tente não parar aqui..."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Não! Não adianta insistir! Não irei deixa-lo entrar! Céus! Mais um maluco..."
