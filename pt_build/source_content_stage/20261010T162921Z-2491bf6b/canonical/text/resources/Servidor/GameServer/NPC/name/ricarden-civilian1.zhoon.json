  "semantic": {
    "entries": [
      {
        "line": 1,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Longbo, o Garoto"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Ouvi dizer que um torneio chamado 'Bellatra' ocorre em Navisko. A cada Round conquistado, sua recompensa aumenta. Você parece ser forte. Porque não tenta visitar Bellatra?"
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Tudo mudou da noite para o dia. Minhas pernas cresceram, minha face mudou. E mais, toda a cidade foi alterada... Ok ok, isso tudo é divertido. Mas, e aquela estátua que costumava ficar atrás de mim, pra onde foi?."
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Já ouviu falar do Templo Sombrio? Ele fica entre a Caverna dos Cogumelos e a Caverna das Abelhas. Criaturas horríveis perambulam pelo local. Quando for forte o bastante, tente se aventurar por lá."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Ouvi dizer que o tal de 'Templo Maldito' fica no meio do deserto. Eu nunca fui lá... Seria um sonho visitar o local, pois somente os mais poderosos podem entrar."
      },
      {
        "line": 7,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Você já conhece os Portais? Eles foram criados pelo 'Inventor dos Portais' e são excelentes para levar os guerreiros de um lugar ao outro, rapidamente. Que tecnologia fantástica!"
      },
      {
        "line": 8,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Costumava haver uma estátua gigante, aqui. Eu tirava minhas sonecas nela... Aquilo, sim, era gostoso."
      },
      {
        "line": 9,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Existe uma cidade chamada Navisko, onde os civis se transformam em monstros, durante a noite. Uma maldição desconhecida assombra o local. Os moradores não sabem dessa transformação..."
      },
      {
        "line": 10,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Eu costumava ser uma aberração, mais uma força sobrenatural me transformou neste belo garoto que está à sua frente. Não me irrite, ou irei voltar à minha verdadeira forma, ok?"
      }
    ]
  },
  "compatibility": {
    "encoding": "base64",
    "legacy_payload_base64": ""
  }
}
