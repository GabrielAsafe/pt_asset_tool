    "entries": [
      {
        "line": 1,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Guardião da Caverna"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Você tem que se concentrar, quando estiver dentro do Santuário, pois a força negra poderá dominá-lo!"
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Esta é a entrada da Caverna, que leva ao Santuário Sombrio. Até as criaturas da caverna se transformam em monstros, devido à força negra do Santuário..."
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Somente jogadores acima do Nível 55 podem entrar aqui."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Você pode caminhar da Caverna das Abelhas à Caverna dos Cogumelos, passando pelo Santuário Sombrio, se for forte o bastante."
      }
    ]
