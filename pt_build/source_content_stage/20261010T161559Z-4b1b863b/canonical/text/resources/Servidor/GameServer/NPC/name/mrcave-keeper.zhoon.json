  "semantic": {
    "entries": [
      {
        "line": 1,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Guarda da Caverna"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Esta é a Caverna das Abelhas. Monstros perigosos vivem ali dentro e atacam todos os que se aproximam. Somente os mais fortes podem entrar..."
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Antes, essa era apenas uma Colônia, mas, graças a uma maldição desconhecida, os monstros dominaram o local. Agora, ela é conhecida como 'Caverna das Abelhas'."
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Existe uma passagem subterrânea, que leva ao Santuário Sombrio. Monstros perigosos o aguardam lá. Fique longe!"
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Se você é forte o bastante, pode vir da Caverna dos Cogumelos, pelo Santuário Sombrio, até essa Caverna."
      }
    ]
  },
