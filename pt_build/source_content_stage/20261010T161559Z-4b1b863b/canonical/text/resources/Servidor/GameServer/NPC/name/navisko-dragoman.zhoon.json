    "entries": [
      {
        "line": 2,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Guarda de Navisko"
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Existem rumoes de que muitos monstros aparecem à noite, mais eu nunca vi nenhum deles... Que estranho!"
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "As pessoas que vêm pelo Portal me deixam louco. Não posso controlá-los, a menos que usem o Portão de entrada..."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Muitas pessoas vêm aqui para participar ou assistir ao desafio de Bellatra. Não é fácil proteger a cidade, sozinho."
      },
      {
        "line": 7,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Eu juro que vi um Bargon, aqui, ontem à noite... Algo está errado..."
      }
    ]
