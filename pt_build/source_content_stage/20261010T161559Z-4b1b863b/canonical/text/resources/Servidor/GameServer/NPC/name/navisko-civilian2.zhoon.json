  "semantic": {
    "entries": [
      {
        "line": 4,
        "legacy_key": "J_Name",
        "kind": "name",
        "text": "Civil Minuren"
      },
      {
        "line": 7,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Navisko fica na parte Sul do continente. Muitos guerreiros tem medo de visitá-la. Coisas bizarras acontecem..."
      },
      {
        "line": 9,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Com a chegada de Bellatra, Navisko se tornou uma cidade famosa..."
      },
      {
        "line": 11,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Você estará muito cansado, amanhã. A falta de água do lugar diminui a resistência dos guerreiros. Que lugar deserto!"
      },
      {
        "line": 13,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Você já experimentou o portal do centro da cidade? É incrivel! Como ele transporta os guerreiros tão rápido?"
      },
      {
        "line": 15,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Eu tive um sonho a noite passada. Um Mecânico me atacou. Doeu tanto. Parecia ser tão real. Até mesmo agora, sinto como se fosse."
      }
    ]
  },
