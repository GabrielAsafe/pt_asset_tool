  "semantic": {
    "entries": [
      {
        "line": 4,
        "legacy_key": "J_Name",
        "kind": "name",
        "text": "Vovó Molly"
      },
      {
        "line": 7,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Eu sou louca por doces. Talvez seja porque estou ficando velha... você não teria alguma coisa com mel, aí, teria?"
      },
      {
        "line": 9,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Às vezes, os guerreiros se perdem na cidade. O Portal, ao Sul, é o jeito mais fácil de entrar na vila..."
      },
      {
        "line": 11,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Esta é Pillai, capital dos Morions. Nossa magia mantém a cidade suspensa no ar e o ambiente sereno de todos os dias."
      },
      {
        "line": 13,
        "legacy_key": "J_Chat",
        "kind": "chat",
        "text": "Lembre-se de que o Portal, ao Norte, serve para visitar outros lugares..."
      }
    ]
  },
