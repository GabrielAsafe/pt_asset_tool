    "entries": [
      {
        "line": 3,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Guarda do Castelo"
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Quando o cerco ao Castelo começa, eu saio correndo! Mas não pense que sou um covarde..."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Você não pode entrar no Castelo agora!"
      },
      {
        "line": 7,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Ninguém pode entrar no Castelo, neste instante."
      },
      {
        "line": 8,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Se você ver minha amada Cecília, diga a ela que estou bem."
      },
      {
        "line": 9,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Quando o Castelo abre suas portas, grandes guerras acontecem."
      },
      {
        "line": 10,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Fiz um teste para entrar na Guarda Imperial, mas disseram que estou meio gordinho..."
      }
    ]
