        "text": "Danu"
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "I wish the Wealth of Ground and love will follow your life..."
      },
      {
        "line": 9,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "You're late! Ardor is going on the battle."
      },
      {
        "line": 10,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Which team is going to win?"
      },
      {
        "line": 11,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "You look very strong too."
      },
      {
        "line": 14,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Sorry, You cannot join in Ardor right now."
      },
      {
        "line": 15,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Rewards are handed and the stadium is cleaned and under maintenance at this time of every day."
      },
      {
        "line": 16,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Please come back later."
      },
