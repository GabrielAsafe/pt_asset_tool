      {
        "line": 1,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Curioso Perdido"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Às vezes, alguns monstros invadem nossas casas. Nada pode detê-los porque a cidade está no meio do deserto!"
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Eu costumava ser um Nômade. Mas, agora, meu lugar é aqui..."
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Não sei porque Ruinen não mudou nada..."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Algum dia, eu tornarei este num magnífico lugar para se viver, eu juro!"
      }
