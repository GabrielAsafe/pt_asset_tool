        "line": 1,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Guarda de Ricarten"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Esta é Ricarten, localizada ao Sul do continente de Priston."
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Muitas pessoas vivem aqui, mas este é um lugar calmo, sem muitos problemas..."
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Muitos guerreiros passam por aqui, o que nos torna o maior centro comercial de Priston Tale..."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Qual o nome desta cidade? Esta é Ricarten! Capital dos Tempskrons! Jamais se esqueça disso!"
      },
      {
        "line": 7,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Se for sua primeira batalha, comece com os Hoppies ou Cogumelos. Quando estiver pronto, tente lutar contra os Duendes, ao Oeste da região..."
      }
