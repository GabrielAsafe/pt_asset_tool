      {
        "line": 1,
        "legacy_key": "J_NAME",
        "kind": "name",
        "text": "Newter, o Sábio"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Não importa qual tribo é mais forte, Morions ou Tempskrons. Devemos respeitar as diferenças de cada civilização..."
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Eu desenvolvi uma nova tecnologia chamada 'Teletransporte', mas ainda não pude usá-la..."
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Você poderá usar o Teletransporte para chegar a lugares para os quais sua Asa não pode levá-lo..."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Uma vez teletransportado, você terá que andar ou usar um Core para voltar para sua Cidade..."
      }
    ]
