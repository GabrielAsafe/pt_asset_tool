        "kind": "name",
        "text": "3ª Loja do Maron"
      },
      {
        "line": 3,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Esta é a terceira Loja Mágica do Mestre Maron. Não se preocupe. A qualidade ainda é a mesma."
      },
      {
        "line": 4,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "A qualidade ainda é a mesma. A única diferença é que estes itens não foram feitos em Pillai."
      },
      {
        "line": 5,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "O Sr. Maron é o único que poderá produzir tais equipamentos em todo o continente."
      },
      {
        "line": 6,
        "legacy_key": "J_CHAT",
        "kind": "chat",
        "text": "Se você precisar de mais artefatos mágicos, veja nossos produtos. Somos pioneiros na confecção de equipamentos místicos."
      }
