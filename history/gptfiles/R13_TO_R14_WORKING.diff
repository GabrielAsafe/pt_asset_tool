+def choose_standalone_animation_representatives(registry, resolver, *, per_domain: int = 2) -> dict[str, list[dict[str, Any]]]:
+    root = pathlib.Path(getattr(registry, "project_root", pathlib.Path(__file__).resolve().parents[1]))
