+    assert len(reps) == 3
+    assert all(r["candidate_basis"] == "EXACT_SIBLING_STEM" for r in reps)
+    assert all(Path(r["asset"]).stem.casefold() == Path(r["skeleton_smb"]).stem.casefold() for r in reps)
