+def _valid_lods(asset, cfg: dict[str, Any]) -> list[str]:
+    out=[]
+    groups=cfg.get("lod_groups") or {}
+    for lod in ("high", "default", "low"):
+        if not (groups.get(lod) or []):
+            continue
+        cov=effective_lod_node_coverage(asset,cfg,lod)
+        if cov.get("status") == "PASS":
+            out.append(lod)
+    return out
