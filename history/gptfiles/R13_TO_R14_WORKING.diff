+def _cell(count: int, state: str, *, next_gate: str | None = None, evidence: dict[str, Any] | None = None) -> dict[str, Any]:
+    row: dict[str, Any] = {"asset_count": int(count), "state": state}
+    if next_gate:
+        row["next_gate"] = next_gate
+    if evidence:
+        row["evidence"] = evidence
+    return row
+
