{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://summit.local/schemas/model_config.schema.json",
  "title": "Summit Model Config v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "id",
    "logical_config",
    "legacy_cache",
    "consumers",
    "source",
    "semantic"
  ],
  "properties": {
    "schema": {
      "const": "summit.model-config/v1"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^model\\.[a-z0-9_.-]+$"
    },
    "logical_config": {
      "type": "string",
      "minLength": 1
    },
    "legacy_cache": {
      "type": "string",
      "minLength": 1
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "json_path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "monster_definition",
              "npc_definition"
            ]
          },
          "json_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        }
      },
      "additionalProperties": true
    },
    "semantic": {
      "type": "object",
      "additionalProperties": true
    },
    "inventory_presence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
